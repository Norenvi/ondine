# Python
pipeline/.venv/
backend/.venv/
__pycache__/
*.pyc

# Data (regenerable / volumineuses)
pipeline/data/raw/*
pipeline/data/processed/*
!pipeline/data/raw/.gitkeep
!pipeline/data/processed/.gitkeep
frontend/public/data/*
!frontend/public/data/.gitkeep
# Exception : committes malgre "regenerable", car le build Render (deploiement du Static
# Site) n'execute pas le pipeline Python, donc ces fichiers doivent deja etre dans le repo.
!frontend/public/data/communes_durete.geojson
!frontend/public/data/epci.geojson
!frontend/public/data/departement.geojson
!frontend/public/data/region.geojson
# Same exception for the PMTiles the map itself renders from (build_tiles.py); the plain
# GeoJSON above stays for entities.ts (search/bbox index only, not map rendering anymore).
!frontend/public/data/communes_durete.pmtiles
!frontend/public/data/epci.pmtiles
!frontend/public/data/departement.pmtiles
!frontend/public/data/region.pmtiles

# Frontend
frontend/node_modules/
frontend/dist/

# Secrets
.env
backend/.env
pipeline/.env

# Divers
.DS_Store
*.log
