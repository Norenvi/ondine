ondine-eau.fr {
	root * /srv
	encode zstd gzip

	# Fichiers geo : cache court cote navigateur, on regenere mensuellement
	@geo path *.geojson *.mbtiles *.pbf
	header @geo Cache-Control "public, max-age=3600"

	# API FastAPI : meme origine cote navigateur, pas de souci CORS
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Umami : script de tracking + endpoint de collecte (meme origine que le site).
	handle_path /stats/* {
		reverse_proxy umami:3000
	}

	handle {
		file_server
		try_files {path} /index.html
	}
}

# Dashboard admin Umami : sous-domaine dedie plutot qu'un sous-chemin, l'image Umami
# officielle n'est pas subpath-aware (basePath Next.js fige au build). Protege par le
# login Umami lui-meme, aucune restriction supplementaire cote Caddy.
analytics.ondine-eau.fr {
	reverse_proxy umami:3000
}
