ondine-eau.fr {
	root * /srv
	encode zstd gzip

	# Fichiers geo : cache court cote navigateur, on regenere mensuellement
	@geo path *.geojson *.mbtiles *.pbf
	header @geo Cache-Control "public, max-age=3600"

	# API FastAPI : meme origine cote navigateur, pas de souci CORS
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Umami : script de tracking + endpoint de collecte uniquement (le dashboard admin
	# n'est pas expose publiquement, voir docker-compose.yml / CLAUDE.md pour l'acces via tunnel SSH)
	handle_path /stats/* {
		reverse_proxy umami:3000
	}

	handle {
		file_server
		try_files {path} /index.html
	}
}
